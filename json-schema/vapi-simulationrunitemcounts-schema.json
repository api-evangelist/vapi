{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SimulationRunItemCounts",
  "title": "SimulationRunItemCounts",
  "type": "object",
  "properties": {
    "total": {
      "type": "number",
      "description": "Total number of run items"
    },
    "passed": {
      "type": "number",
      "description": "Number of passed run items"
    },
    "failed": {
      "type": "number",
      "description": "Number of failed run items"
    },
    "running": {
      "type": "number",
      "description": "Number of running/evaluating run items"
    },
    "queued": {
      "type": "number",
      "description": "Number of queued run items"
    },
    "canceled": {
      "type": "number",
      "description": "Number of canceled run items"
    }
  },
  "required": [
    "total",
    "passed",
    "failed",
    "running",
    "queued",
    "canceled"
  ]
}
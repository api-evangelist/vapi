{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/InviteUserDTO",
  "title": "InviteUserDTO",
  "type": "object",
  "properties": {
    "emails": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "enum": [
        "admin",
        "editor",
        "viewer"
      ],
      "type": "string"
    },
    "redirectTo": {
      "type": "string"
    }
  },
  "required": [
    "emails",
    "role"
  ]
}
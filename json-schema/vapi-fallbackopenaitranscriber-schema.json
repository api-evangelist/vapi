{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FallbackOpenAITranscriber",
  "title": "FallbackOpenAITranscriber",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "This is the transcription provider that will be used.",
      "enum": [
        "openai"
      ]
    },
    "model": {
      "type": "string",
      "description": "This is the model that will be used for the transcription.",
      "enum": [
        "gpt-4o-transcribe",
        "gpt-4o-mini-transcribe"
      ]
    },
    "language": {
      "type": "string",
      "description": "This is the language that will be set for the transcription.",
      "enum": [
        "af",
        "ar",
        "hy",
        "az",
        "be",
        "bs",
        "bg",
        "ca",
        "zh",
        "hr",
        "cs",
        "da",
        "nl",
        "en",
        "et",
        "fi",
        "fr",
        "gl",
        "de",
        "el",
        "he",
        "hi",
        "hu",
        "is",
        "id",
        "it",
        "ja",
        "kn",
        "kk",
        "ko",
        "lv",
        "lt",
        "mk",
        "ms",
        "mr",
        "mi",
        "ne",
        "no",
        "fa",
        "pl",
        "pt",
        "ro",
        "ru",
        "sr",
        "sk",
        "sl",
        "es",
        "sw",
        "sv",
        "tl",
        "ta",
        "th",
        "tr",
        "uk",
        "ur",
        "vi",
        "cy"
      ]
    }
  },
  "required": [
    "provider",
    "model"
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateMinimaxCredentialDTO",
  "title": "CreateMinimaxCredentialDTO",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "minimax"
      ]
    },
    "apiKey": {
      "type": "string",
      "description": "This is not returned in the API."
    },
    "groupId": {
      "type": "string",
      "description": "This is the Minimax Group ID."
    },
    "name": {
      "type": "string",
      "description": "This is the name of credential. This is just for your reference.",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "provider",
    "apiKey",
    "groupId"
  ]
}
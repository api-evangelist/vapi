{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OpenAIMessage",
  "title": "OpenAIMessage",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "nullable": true,
      "maxLength": 100000000
    },
    "role": {
      "type": "string",
      "enum": [
        "assistant",
        "function",
        "user",
        "system",
        "tool"
      ]
    }
  },
  "required": [
    "content",
    "role"
  ]
}
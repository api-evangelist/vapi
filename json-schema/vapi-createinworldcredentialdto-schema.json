{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateInworldCredentialDTO",
  "title": "CreateInworldCredentialDTO",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "inworld"
      ]
    },
    "apiKey": {
      "type": "string",
      "description": "This is the Inworld Basic (Base64) authentication token. This is not returned in the API.",
      "example": "your-base64-token-here"
    },
    "name": {
      "type": "string",
      "description": "This is the name of credential. This is just for your reference.",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "provider",
    "apiKey"
  ]
}